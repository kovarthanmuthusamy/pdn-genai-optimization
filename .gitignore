# ── Python caches / build ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── Environments / IDE ─────────────────────────────────────────────────
.venv/
venv/
.vscode/
.idea/

# ── Personal Claude Code settings (team settings.json stays tracked) ───
.claude/settings.local.json

# ── Excluded project directories ───────────────────────────────────────
src_gan/
temp_visuals/
ppt/
datasets/
data_multi_norm_robust/
.github/
!.github/workflows/
.cursor/

# ── Active-learning runs: decision reports and evals are tracked, the ──
#    raw per-iteration arrays (7.8 GB) are not.
active_learning_pi/runs/**/*.npy
active_learning_pi/runs/**/*.map
active_learning_pi/runs/**/*.Identifier
#    Raw candidate pools (1.6 GB); the decision ledgers, cycle evals and
#    rank-quality reports that cite them stay tracked.
active_learning_pi/runs/**/candidates.json
active_learning_pi/runs/**/scored_candidates.json
active_learning_pi/runs/**/scored_candidates_post_finetune.json
#    Per-sample manifests; selected_for_simulation.csv keeps the same
#    selection record in ~10k lines instead of ~3.1M.
active_learning_pi/runs/**/selected_for_simulation.json
active_learning_pi/runs/**/normalize_report.json
active_learning_pi/runs/**/ingest_manifest.json

# ── Generated experiment figures and sweep samples ─────────────────────
experiments/**/*.png
experiments/**/multifreq_heatmap_sweep_*/**/*.npy
experiments/**/multifreq_heatmap_sweep_*/**/*.map

# ── Oversized generated comparison reports (embedded base64 images) ────
experiments/**/comparison_report_*.html

# ── Model checkpoints (large; regenerated by training) ─────────────────
checkpoints/
**/checkpoints/
*.pt
*.pth
*.ckpt
*.h5

# ── Large binary simulation / heatmap exports ──────────────────────────
*.peb

# ── Oversized generated report (trips GitHub's 50MB warning) ───────────
experiments/exp037_lat_change/comparison_report_before_surrgate.html

